<%- include ('partials/header') %>
<main class="project-details-page">

    <section class="project-details-card">

        <h1><%= projectDetails.title %></h1>
        <section>
            <% if (user && user.role_name === 'admin') {%>
                <div class="project-actions">
                    <a href="/assign-categories/<%=projectDetails.project_id%>" class="btn-primary">
                        Edit Categories
                    </a>
                
                    <a href="/edit-project/<%=projectDetails.project_id%>" class="btn-primary">
                        Update Project
                    </a>
                </div>
            <%}%>    
        </section>   

        <p>
            <strong>Description:</strong>
            <%= projectDetails.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(projectDetails.date).toDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= projectDetails.location %>
        </p>

        <p>
            <strong>Partner Organization:</strong>
            <a href="/organization/<%=projectDetails.organization_id%>"><%= projectDetails.organization_name %></a>
        </p>

        <div class="category-tags">
            <strong>Categories:</strong>
            <%projectCategories.forEach(category => {%>
                <a href="/category/<%=category.category_id%>" class="tag"><%=category.category_name%></a>
            <%});%>
        </div>

        <% if (user) {%>
            <% if (!isVolunteer) {%>

                <form action="/volunteer/<%= projectDetails.project_id %>" method="POST">
                    <button type="submit" class="submit-btn">
                        Volunteer for this Project
                    </button>
                </form>

            <% } %>

            <% if(isVolunteer) {%>
                <p class="volunteer-status">
                    You are volunteering for this project
                </p>

                <form action="/no-volunteer/<%= projectDetails.project_id %>" method="POST">
                    <input type="hidden" name="redirectTo" value="/project/<%= projectDetails.project_id %>">
                    <button type="submit" class="submit-btn">
                        Stop Volunteering
                    </button>
                </form>

            <% } %>
        <% } %>        
    </section>
    
</main>
<%- include ('partials/footer') %>