<%- include('partials/header') %>

<main class="project-categories-page">

    <section class="project-categories-card">

        <h1><%= title %></h1>
        <h2><%= projectDetails.title %></h2>

        <p class="page-description">
            Select all categories that apply to this project.
        </p>
        <!-- FORM -->
        <form
            action="/assign-categories/<%=projectId%>"
            method="POST"
        >

            <div class="categories-checkboxes">

                <% categories.forEach(category => { %>

                    <label class="category-option">

                        <input
                            type="checkbox"
                            name="categoryIds"
                            value="<%= category.category_id %>"

                            <%= assignedCategories.some(
                                assigned =>
                                    assigned.category_id === category.category_id
                            )
                                ? 'checked'
                                : ''
                            %>
                        >

                        <span>
                            <%= category.name %>
                        </span>

                    </label>

                <% }) %>

            </div>

            <!-- SUBMIT BUTTON -->
            <button
                type="submit"
                class="submit-btn"
            >
                Save Categories
            </button>

        </form>

    </section>

</main>

<%- include('partials/footer') %>