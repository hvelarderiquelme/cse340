<%- include('partials/header') %>
<main class="organizations-page">

    <h1><%= title %></h1>

    <p class="intro">
        Here are a few of our partner organizations:
    </p>

    <p class="page-action">
        <a href="/new-organization">Add a new organization</a>
    </p>

    <ul class="organization-grid">
        <% organizations.forEach(organization => { %>
            <li class="organization-card">
                <img src="/images/<%= organization.logo_filename%>"
                     alt="<%= organization.name %> logo">
                <a href="/organization/<%= organization.organization_id %>"> <%= organization.name %></a>
                <p>Email: <%= organization.contact_email %></p>
            </li>    
        <% }); %>
    </ul>       
    

</main>
<%- include('partials/footer') %>