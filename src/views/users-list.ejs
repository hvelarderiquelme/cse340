<%- include ('partials/header')%>
<main class="users-page">
    
    <h1><%=title%></h1>

    <table class="users-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Username</th>
            <th>User Role</th>
        </tr>
    </thead>
    <tbody>
        <% usersList.forEach(user => { %>
            <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td><%= user.role_name %></td>
            </tr>
        <% }) %>
    </tbody>
</table>

</main>
<%- include ('partials/footer')%>